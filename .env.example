# Token do bot Discord
DISCORD_TOKEN=

# Client ID da aplicacao Discord (obrigatorio para registrar slash commands)
CLIENT_ID=

# Guild ID opcional, usado apenas em desenvolvimento para registrar comandos
# instantaneamente em um unico servidor (comandos globais demoram ate 1h para propagar)
DEV_GUILD_ID=

# Modo debug (true/false) - imprime informacoes detalhadas no console
DEBUG=false


# ---- Motor de respostas ----
# "algorithm" (padrao): motor leve baseado em casamento de padroes, sem IA
# generativa, sem chamadas de rede e sem uso extra relevante de RAM. E o modo
# recomendado para hospedagens com pouca RAM, como a Discloud (100MB).
#
# "ollama": usa um modelo de linguagem local via Ollama como principal,
# com Groq como fallback automatico se o Ollama falhar (requer uma
# maquina/VPS com varios GB de RAM livres - NAO funciona no plano de 100MB
# da Discloud; pensado para um servidor proprio, ex: Oracle Cloud).
#
# "groq": usa a API do Groq diretamente (sem precisar de servidor Ollama),
# com o motor algoritmico como fallback. Mais simples de configurar que o
# modo "ollama" e ainda muito barato (ver GROQ_API_KEY abaixo).
#
# Em qualquer modo, se o provider escolhido nao estiver disponivel (ou o
# teto de gasto do Groq for atingido), o bot cai automaticamente para o
# motor algoritmico - nunca fica sem responder por causa disso.
AI_PROVIDER=ollama

# Id do criador ( Dono/host do bot)
CREATOR_ID=

# Utilizado como fallback ou provider principal.
# Groq (https://console.groq.com) tem um free tier generoso e planos
# Token barato, por isso usamos aqui, o gasto mensal maximo é de 0,50R$ caso queira trocar vá no config.example.json
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Chave de criptografia (AES-256-GCM) para o arquivo de dados em disco
# (memorias, economia, XP, etc). Gere uma com: npm run generate-key
# Sem esta chave, o bot funciona normalmente mas grava os dados em texto
# puro (ok para desenvolvimento local; recomendado definir em producao).
# NUNCA coloque esta chave no Git - guarde em um secret manager ou apenas
# no .env do servidor de producao.
MEMORY_ENCRYPTION_KEY=
